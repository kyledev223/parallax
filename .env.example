# Copy to .env.local. Everything is optional: the app runs with no env vars.

# Public URL, used for metadata and OpenGraph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Social buttons in the nav and footer. Each is hidden while empty.
# X (Twitter): "@handle", "handle" or a full URL.
NEXT_PUBLIC_TWITTER=
# pump.fun token contract address (links to pump.fun/coin/<CA>).
NEXT_PUBLIC_PUMPFUN_CA=

# --- News (feature flag, off by default) ---
# NEWS_ENABLED=true
# Recommended: a free NewsData.io key (https://newsdata.io). When set, it is the default provider.
# NEWSDATA_API_KEY=
# Force a provider: "newsdata", "gdelt" (free, keyless, often rate-limited) or "rss".
# NEWS_PROVIDER=
# For NEWS_PROVIDER=rss: a search feed URL containing {query}. Check the feed's terms first;
# for example, Google News RSS is licensed for personal, non-commercial use only.
# NEWS_RSS_URL=https://news.google.com/rss/search?q={query}+when:7d&hl=en-US&gl=US&ceid=US:en
